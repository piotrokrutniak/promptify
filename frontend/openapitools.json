{
  "generator-cli": {
    "version": "7.12.0",
    "generators": {
      "v1": {
        "generatorName": "typescript-fetch",
        "inputSpec": "openapi/v1.json",
        "output": "generated/api",
        "additionalProperties": {
          "supportsES6": true,
          "typescriptThreePlus": true,
          "withSeparateModelsAndApi": true
        }
      }
    }
  }
}
