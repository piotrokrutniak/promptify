# Used by server actions, lib/api-client.ts, and SignalR hub URL passed to the browser
# Must be a URL the browser can reach for SignalR (Docker: http://localhost:8080)
# Aspire: use the HTTPS URL from the dashboard (e.g. https://localhost:64675), not Docker :8080
API_BASE_URL=http://localhost:8080

# URL to fetch OpenAPI spec (only needed for generate:api-spec)
OPENAPI_URL=http://localhost:8080/openapi/v1.json

# Self-signed Aspire HTTPS certs are handled by NODE_TLS_REJECT_UNAUTHORIZED=0 in npm run dev
# and npm run generate:api-spec (same pattern as wassup-web).
