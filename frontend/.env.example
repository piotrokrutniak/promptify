# Server-side API calls (server actions, middleware, route handlers)
# Docker: http://webapi:8080  |  Local dev: http://localhost:8080
API_BASE_URL=http://localhost:8080

# Browser-reachable API URL (SignalR hub)
# Docker: http://localhost:8080  |  Aspire: HTTPS URL from dashboard
PUBLIC_API_BASE_URL=http://localhost:8080

# Set to false when running production Next over HTTP (e.g. local Docker)
# AUTH_COOKIE_SECURE=false

# URL to fetch OpenAPI spec (only needed for generate:api-spec)
OPENAPI_URL=http://localhost:8080/openapi/v1.json

# Self-signed Aspire HTTPS certs are handled by NODE_TLS_REJECT_UNAUTHORIZED=0 in npm run dev
# and npm run generate:api-spec (same pattern as wassup-web).
